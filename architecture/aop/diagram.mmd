flowchart TD
  REQ["📥 Request"] --> FILT["🛡️ Security + rate-limit filters<br/>(429s never reach the aspects)"]
  FILT --> CA["🔍 ControllerLogging<br/>@RestController pointcut"]
  CA --> CTRL["🎯 Controller method"]
  CTRL --> SA["🔍 ServiceMethodsLogging<br/>@Service pointcut"]
  SA --> SVC["⚙️ Service method"]
  SVC --> DB["💾 Repository"]

  CA -.->|"[REQUEST] duration (success only)"| INFO["📋 INFO"]
  SA -.->|"[START] arg count · [END] · [PERFORMANCE]"| INFO
  CA -.->|"[CLIENT_ERROR] expected, no trace"| WARN["📋 WARN"]
  SA -.->|"[ERROR] + trace"| ERR["📋 ERROR"]
  CA -.->|"[EXCEPTION] + trace"| ERR

  INFO -->|"breadcrumbs excluded"| GT["🛡️ GlitchTip"]
  ERR -->|"becomes an event, deduplicated"| GT
  WARN -.->|"below event threshold"| GT
