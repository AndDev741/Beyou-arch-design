flowchart TD
  subgraph lang["Language"]
    DET["🌐 Browser detector<br/>en · pt, fallback en"]
    I18N["i18next<br/>packages/i18n JSONs"]
    DET --> I18N
  end

  subgraph theme["Theme"]
    PREF["Preference string<br/>mode:pack · e.g. dark:cyber"]
    TOK["packages/theme tokens<br/>2 bases × 5 accent packs"]
    LEG["Legacy map<br/>9 old themes → new pairs"]
    PREF --> TOK
    LEG --> PREF
  end

  ACC["👤 Account (backend)<br/>languageInUse · themeInUse"]
  LOC["💾 localStorage<br/>beyou-theme · detector cache"]

  ACC -->|"wins when set"| I18N
  ACC -->|"wins when set"| PREF
  LOC -->|"fallback below account"| PREF

  TOK --> WEB["⚛️ Web: CSS vars on :root<br/>data-theme + color-scheme"]
  TOK --> MOB["📱 Mobile: NativeWind vars"]
  OS["🖥️ prefers-color-scheme"] -->|"system mode, live"| TOK
